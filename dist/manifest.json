{
  "manifest_version": 3,
  "name": "盐译 Oneclear · 字幕测试版",
  "version": "0.8.1",
  "description": "使用自己的模型服务，按需翻译网页。支持双语、仅译文和一键恢复。",
  "minimum_chrome_version": "120",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "盐译 Oneclear · 翻译网页",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png"
    }
  },
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "commands": {
    "toggle-translation": {
      "suggested_key": {
        "default": "Alt+T"
      },
      "description": "翻译 / 恢复原文"
    },
    "toggle-mode": {
      "suggested_key": {
        "default": "Alt+B"
      },
      "description": "双语 / 仅译文切换"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  },
  "short_name": "盐译 Oneclear",
  "version_name": "0.8.1 YouTube preview",
  "host_permissions": [
    "https://www.youtube.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "youtube-content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}